    "source": "docs/research/osm-AG/osm_ag_2/osm_ag_repo/osmAG/src/astarcal.cpp",
    "source_sha256": "ecefad32943c43f3c2d2544e0f7090602feb8546e4de5b6c8dfa1047c26dd4f9",
    "fixture": "Free 12x5 grid; start (1,2), goal (9,2), orthogonal move cost 10",
    "output": {
      "points": 9,
      "reported_cost": 10,
      "cost_from_returned_steps": 80
    },
    "harness_source": "#include <iostream>\n#include \"astarcal.h\"\nint main() {\n  AStarCalc planner;\n  std::vector<std::vector<int>> grid(12,std::vector<int>(5,0));\n  planner.InitSites(grid);\n  CalcPt start(cv::Point(1,2)), goal(cv::Point(9,2));\n  std::vector<int> reported;\n  auto path=planner.GetPath(start,goal,reported);\n  int recomputed=0;bool first=true;cv::Point previous;\n  for(auto point:path) {if(!first) recomputed += (point->pt.x==previous.x || point->pt.y==previous.y) ? 10 : 14;previous=point->pt;first=false;}\n  std::cout << \"{\\\"points\\\":\" << path.size() << \",\\\"reported_cost\\\":\" << (reported.empty()?-1:reported[0]) << \",\\\"cost_from_returned_steps\\\":\" << recomputed << \"}\\n\";\n}\n",
    "compile_command": "c++ -std=c++17 $(pkg-config --cflags opencv5) -I docs/research/osm-AG/osm_ag_2/osm_ag_repo/osmAG/include /tmp/osmag_legacy_astar_probe.cpp docs/research/osm-AG/osm_ag_2/osm_ag_repo/osmAG/src/astarcal.cpp -o /tmp/osmag_legacy_astar_probe $(pkg-config --libs opencv5)"
  },
